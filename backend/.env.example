# Every variable except VALID_API_KEYS has a default (shown below) and is validated on startup

# Server configuration
HOST=http://127.0.0.1
PORT=8000

# API configuration - comma-separated list of valid API keys for authentication (required)
VALID_API_KEYS=admin,qwerty

# Comma-separated list of origins allowed by CORS (the frontend URL)
CORS_ORIGIN=http://localhost:3000

# Path to the KML file with the polygon objects are generated in (relative to the working directory)
MAP_KML_PATH=map.kml

# Simulator load: number of objects (1-20000) and position update interval in ms (100-60000, 100 = 10 Hz)
OBJECTS_COUNT=150
MOVE_INTERVAL_MS=5000
