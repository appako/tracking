{
    "name": "frontend",
    "version": "0.1.0",
    "private": true,
    "packageManager": "yarn@4.13.0",
    "scripts": {
        "start": "webpack serve --mode development",
        "build": "webpack --mode production",
        "typecheck": "tsc --noEmit",
        "orval": "orval",
        "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\""
